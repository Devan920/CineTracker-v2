# Optional static Bearer token for script/CI calls to /api/scrape/* and /api/cache/invalidate
# (Authenticated Supabase Admin JWTs are also accepted automatically)
ADMIN_API_SECRET=change-this-to-a-long-random-secret

# Comma-separated extra frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173

# Optional in-process APScheduler background scraping (GitHub Actions handles hourly sync by default)
ENABLE_INTERNAL_SCHEDULER=false
SCRAPE_INTERVAL_MINUTES=60
