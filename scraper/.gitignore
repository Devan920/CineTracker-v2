# Environment & secrets — NEVER commit these
.env
.env.*
!.env.example
.env.local
.env.*.local

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.venv/
venv/

# Runtime logs & local cache
logs/
logs/*.log
logs/*.log.*
logs/last_run_report.json
cache/*.json

# Mobile / build artifacts (should never appear here, but guard anyway)
android/
ios/
*.apk
*.aab
*.ipa
