# Supabase Credentials (Required for live sync; optional for --dry-run)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# TMDB API v3 Key (Optional for --dry-run; required for live metadata enrichment)
TMDB_API_KEY=your-tmdb-v3-api-key

# Optional X (Twitter) Authenticated Cookies & Fallback Mirrors
X_AUTH_TOKEN=
X_CT0=
X_NITTER_INSTANCES=https://xcancel.com,https://nitter.privacydev.net

# Engine Tuning Overrides (Optional)
SCRAPE_MIN_DELAY_SEC=1.5
SCRAPE_MAX_DELAY_SEC=4.0
SCRAPE_MAX_RETRIES=3
SCRAPE_VARIANCE_THRESHOLD=0.25
LOG_LEVEL=INFO
